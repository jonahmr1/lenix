{
	"extends": ["./tsconfig.rules"],
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "noEmit": true,
  }
}
