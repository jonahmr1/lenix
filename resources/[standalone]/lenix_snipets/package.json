{
  "name": "lenix_snipets",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "server": "bun build src/server/index.ts --outfile dist/server.js",
    "client": "bun build src/client/index.ts --format=iife --target=browser --outfile dist/client.js",
    "build": "bun run server && bun run client",
    "watch": "bun build src/client/index.ts --format=iife --target=browser --outfile dist/client.js --watch"
  },
  "dependencies": {
    "@citizenfx/client": "^2.0.31725-1",
    "@citizenfx/server": "^2.0.31689-1",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
