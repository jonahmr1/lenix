{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "es2023",
		"lib": [
			"ES2023",
			"DOM"
		],
		"module": "esnext",
		"types": [
			"vite/client"
		],
		"skipLibCheck": true,
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",
		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@workspace/ui/*": [
				"../../packages/ui/src/*"
			]
		}
	},
	"include": [
		"src",
		"src/_/lib",
		"src/_/ui",
		"src/_/docs.tsx",
		"src/_/search.ts",
		"src/_/mdx.tsx",
		"src/_/root.tsx",
		"src/_/routes.ts",
		"src/_/create-product.tsx",
		"src/_/product-item.tsx",
		"src/_/product.tsx",
		"src/_/products.tsx"
	]
}